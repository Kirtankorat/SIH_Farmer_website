# HarvestLink Backend Configuration
PROJECT_NAME="HarvestLink API"
VERSION="1.0.0"
API_V1_STR="/api"

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
# For local PostgreSQL instance:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/harvestlink_db

# Fallback SQLite DB for zero-config quick local testing
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./harvestlink.db

# Security & JWT Token
SECRET_KEY=harvestlink_sih_super_secret_jwt_key_2026_production_safe_token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:5500", "http://127.0.0.1:5500", "http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000", "*"]
