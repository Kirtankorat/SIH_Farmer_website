PROJECT_NAME="HarvestLink API"
VERSION="1.0.0"
API_V1_STR="/api"
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Replace with your PostgreSQL credentials:
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/harvestlink_db
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./harvestlink.db

SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5500", "http://127.0.0.1:5500", "*"]
